{
  "name": "dental-clinic-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:vercel": "NITRO_PRESET=vercel vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "pnpm generate-routes && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "node scripts/verify-local-http.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
    "db:test": "supabase test db --local",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:env": "node scripts/setup-local-env.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "6.0.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.114.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "1.59.0",
    "nitro": "3.0.260903-beta",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "7.90.0",
    "shadcn": "^4.22.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.8.1",
    "seroval": "1.6.11",
    "typescript": "^6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "^8.0.0",
    "vitest": "5.0.5"
  }
}
